# Copy to .env and adjust. Every value below has a working default, so the stack runs unmodified.

# ---- database / cache -------------------------------------------------------
POSTGRES_DB=revexa
POSTGRES_USER=revexa
POSTGRES_PASSWORD=revexa
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- ports ------------------------------------------------------------------
API_PORT=8080
WEB_PORT=3000

# ---- security ---------------------------------------------------------------
# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
REVEXA_JWT_SECRET=revexa-local-development-secret-change-me-please-0123456789
REVEXA_CORS_ORIGINS=http://localhost:3000

# ---- AI provider ------------------------------------------------------------
# 'heuristic' is the offline engine and needs no credentials. Switch to 'anthropic' or 'openai'
# and supply the matching key to route the same pipeline through a hosted model.
REVEXA_AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- execution sandbox ------------------------------------------------------
# 'simulated' performs a static dry run; 'disabled' turns the endpoint off entirely.
REVEXA_SANDBOX_PROVIDER=simulated
